{
  "name": "lime",
  "version": "1.3.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-repository.mjs && npm run typecheck && npm run test:goals && npm run test:checkin && npm run test:todos && npm run test:updates && npm run test:theme",
    "build:apk": "bash scripts/build-android.sh release arm64-v8a",
    "build:preview": "bash scripts/build-android.sh preview arm64-v8a",
    "test:todos": "node --test tests/todo-interaction.test.cjs",
    "test:goals": "node --test tests/habit-goals.test.cjs",
    "test:checkin": "node --test tests/checkin-day.test.cjs",
    "test:updates": "node --test tests/update-manifest.test.cjs",
    "test:theme": "node --test tests/theme-controls.test.cjs"
  },
  "dependencies": {
    "@react-navigation/drawer": "^7.14.2",
    "@react-navigation/native": "^7.4.1",
    "expo": "~55.0.31",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-sharing": "~55.0.24",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~55.0.12",
    "typescript": "~5.9.2"
  },
  "codegenConfig": {
    "name": "LimeUpdaterSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.androidsoftwaredaily.habitcheckin"
    }
  },
  "private": true,
  "license": "MIT",
  "description": "Offline Android habits, tasks and memos with local backup and restore.",
  "repository": {
    "type": "git",
    "url": "https://github.com/2742360657/Lime.git"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
