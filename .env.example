# Development environment example; copy settings to ignored .local/dev.env.
# This configures build tools, not the product's API keys or a server.
# LIME_TOOLCHAIN_HOME=/absolute/path/to/existing/tools-root
# LIME_ANDROID_SDK_DIR=/absolute/path/to/android-sdk
# LIME_JDK_DIR=/absolute/path/to/jdk17
# LIME_NODE_DIR=/absolute/path/to/node22
# LIME_EXPECTED_MOUNT=/optional/data-disk/mount
# LIME_KEYSTORE_DIR=/absolute/path/to/private/signing-directory
